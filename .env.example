# TestPilot Global Environment Configuration Example

# Backend configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./testpilot.db

# JWT Security
# In production, generate a secure random 32+ byte string (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change-this-in-production-to-a-super-secret-32-byte-key-min!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend configuration
VITE_API_BASE_URL=http://localhost:8000
